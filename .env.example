# Credentials for the local validation tools. Copy to .env and fill in.
# .env is gitignored. Nothing here is read by the library itself -- only by
# the scripts in tools/.

# Issued by FloLogic for the API-key flow (GET /Token). Both are required: the
# token endpoint rejects a key without its company ID.
FLOLOGIC_API_KEY=
FLOLOGIC_COMPANY_ID=

# The webhook signing secret from Dashboard > API Manager. Used to verify the
# X-FloLogic-Signature header on callbacks.
FLOLOGIC_WEBHOOK_SECRET=

# Optional, for tools/compare.py: an account for the unofficial app-protocol
# library in ../pyflologic-unofficial, read from that repository's own .env.
# FLOLOGIC_UNOFFICIAL_ACCOUNT=david
